<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRobotContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- HÀNG TRÊN: CON ROBOT TÁCH NỀN + DÒNG CHỮ BÁO CON/CÁI TỶ LỆ THẬT KẾ BÊN -->
    <LinearLayout
        android:id="@+id/robotHudRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Con Robot 3D tách nền hoàn toàn (Kéo thả di chuyển, bấm để mở/đóng bảng chi tiết) -->
        <ImageView
            android:id="@+id/ivRobotCutout"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:contentDescription="Robot AI"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_robot_cutout" />

        <!-- Bảng chữ báo Con/Cái & Tỷ lệ thật nằm ngay kế bên con Robot -->
        <LinearLayout
            android:id="@+id/sideCalloutBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_side_callout"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSideCalloutMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👁️ AUTO SOI BÀN..."
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnToggleDrawer"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="▼"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSideCalloutSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Thật: P 0 (0%) | B 0 (0%) | T 0"
                android:textColor="#ECEFF1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSideBridgeTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Nhịp cầu: Đang đọc dữ liệu màn hình"
                android:textColor="#FFD54F"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- NGĂN CHI TIẾT MỞ RỘNG (Bấm vào Robot hoặc nút ▼ để xem cầu & quét bảng) -->
    <LinearLayout
        android:id="@+id/detailDrawerPanel"
        android:layout_width="285dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_mini_drawer"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvLastDetectedEvent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vừa bắt: Chưa có ván nào"
                android:textColor="#80DEEA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#33FF5252"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="✕ Tắt Tool"
                android:textColor="#FF8A80"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBridgeAnalysisDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Phân tích cầu thật: Chờ tối thiểu 3 tay P/B"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvToolWinLossStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Hiệu suất chốt thật: 0W - 0L (Chưa vào lệnh)"
            android:textColor="#A5D6A7"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHistoryTape"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Chuỗi tay bắt được: Trống"
            android:textColor="#CFD8DC"
            android:textSize="11sp" />

        <!-- Hàng nút chính: Quét Bảng Cầu / Tạm dừng / Bàn mới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenRoadScanner"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.25"
                android:backgroundTint="#0288D1"
                android:text="📊 Quét Bảng Cầu"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTogglePause"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="0.95"
                android:backgroundTint="#00897B"
                android:text="⏸ Tạm dừng"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnResetTable"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="0.85"
                android:backgroundTint="#455A64"
                android:text="🔄 Bàn mới"
                android:textColor="#FFCC80"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Hàng nút hiệu chỉnh nhanh nếu muốn sửa tay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddP"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:backgroundTint="#1E88E5"
                android:text="+P"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnAddB"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#E53935"
                android:text="+B"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnAddT"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#2E7D32"
                android:text="+T"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnUndoLast"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="#546E7A"
                android:text="Xóa 1"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
